# ==========================================================
# 部署时通常只需填这一项：ZeroSSL API key。其余保持默认即可。
# ==========================================================

# ZeroSSL API access key（https://app.zerossl.com/developer）
ZEROSSL_API_KEY=

# 留空则启动时自动探测本机公网 IPv4。多 IP 机器建议显式填写
CERT_IP=

CERT_VALIDITY_DAYS=90
RENEW_BEFORE_DAYS=30
CHECK_INTERVAL_HOURS=12

# 设为 1 强制重新签发，完成后改回 0
FORCE_ISSUE=0

# ============ human-gate 人机验证闸门 / 访客上报 ============
# 下面已填好默认中心配置，通常无需改动，直接部署即可接入。
# 若分析中心迁移/独立部署，改这里的地址与密钥即可。
GATE_REPORT_URL=https://103.91.219.84:9443/__gate/ingest
GATE_REPORT_TOKEN=DmFYMD6jQZSiQ2yGQywTiEWCED7AyKy
# 中心用自签/IP 证书时置 1，跳过证书校验（防伪造仍由 token 保证）
GATE_REPORT_INSECURE=1
# 通行证有效期（小时）
GATE_PASS_TTL_HOURS=12
# 滑块总开关：on=开启人机验证（默认）；off=纯反代不弹滑块（如本机专门反代 API）。
# 关闭后仍会采集并上报访客数据，只是不拦截。
GATE_ENABLE=on
# ============ 验证页客服（每个部署可独立修改）============
# 配置任一客服项即自动启用；设 off 可强制关闭第三方客服（仍显示刷新与故障码）。
GATE_SUPPORT_ENABLE=
GATE_SUPPORT_TEXT=验证遇到问题？联系客服
# 强烈建议填写一个无需JS的客服/工单链接，作为第三方脚本失败时的兜底。
GATE_SUPPORT_URL=
# SaleSmartly/Crisp等单个外链客服脚本，只填写 src URL，不要写<script>标签。
GATE_SUPPORT_SCRIPT_URL=
# 任意可信客服HTML可使用Base64，或写入 human-gate/data/support.html。
GATE_SUPPORT_HTML_B64=
GATE_SUPPORT_HTML_FILE=
# 策略默认每60秒同步；通常无需修改。地址会从 GATE_REPORT_URL 自动推导。
GATE_POLICY_INTERVAL_SEC=60
